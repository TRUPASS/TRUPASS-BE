root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
# google-java-format 기준(2칸 들여쓰기, 100자). 포맷은 `./gradlew spotlessApply`로 맞춘다.
indent_size = 2
max_line_length = 100

[*.gradle]
indent_size = 4

[*.py]
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
