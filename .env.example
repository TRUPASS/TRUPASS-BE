# cp .env.example .env 후 값을 채운다. 실제 값은 노션에서 공유한다. .env는 절대 커밋하지 않는다.

# DB
POSTGRES_DB=trupass
POSTGRES_USER=trupass
POSTGRES_PASSWORD=

# 외부 연동 구현체 선택 (mock | duffel, mock | toss, localfile | s3)
TRUPASS_CLIENTS_MERCHANT=mock
TRUPASS_CLIENTS_PAYMENT=mock
TRUPASS_CLIENTS_AUDIT=localfile

# 내부 서비스 주소
AGENT_BASE_URL=http://agent:8001
MOCK_MERCHANT_BASE_URL=http://mock-merchant:9001
CORE_BASE_URL=http://core:8080

# 로그인
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션). 쉼표로 여러 개.
GOOGLE_OAUTH_CLIENT_IDS=
# access token(JWT) 서명 키, 32바이트 이상. 생성: openssl rand -base64 48 (로컬은 비워 둬도 개발용 키로 뜬다. 운영은 필수)
TRUPASS_JWT_SECRET=

# 외부 API (테스트 키)
TOSS_SECRET_KEY=
DUFFEL_ACCESS_TOKEN=
TOURAPI_SERVICE_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
