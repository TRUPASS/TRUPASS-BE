# cp .env.example .env 후 값을 채운다. 실제 값은 노션에서 공유한다. .env는 절대 커밋하지 않는다.

# DB
POSTGRES_DB=trupass
POSTGRES_USER=trupass
POSTGRES_PASSWORD=

# 어댑터 선택
TRUPASS_ADAPTERS_MERCHANT=mock
TRUPASS_ADAPTERS_PAYMENT=mock
TRUPASS_ADAPTERS_AUDIT=localfile

# 내부 서비스 주소
AGENT_BASE_URL=http://agent:8001
MOCK_MERCHANT_BASE_URL=http://mock-merchant:9001
CORE_BASE_URL=http://core:8080

# 외부 API (테스트 키)
TOSS_SECRET_KEY=
DUFFEL_ACCESS_TOKEN=
TOURAPI_SERVICE_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
