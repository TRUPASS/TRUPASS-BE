# cp .env.example .env 후 값을 채운다. 실제 값은 노션에서 공유한다. .env는 절대 커밋하지 않는다.

# DB
POSTGRES_DB=trupass
POSTGRES_USER=trupass
POSTGRES_PASSWORD=

# 외부 연동 구현체 선택 (mock | duffel, mock | toss, localfile | s3)
TRUPASS_CLIENTS_MERCHANT=mock
TRUPASS_CLIENTS_PAYMENT=mock
TRUPASS_CLIENTS_AUDIT=localfile

# 내부 서비스 주소
AGENT_BASE_URL=http://agent:8001
MOCK_MERCHANT_BASE_URL=http://mock-merchant:9001
CORE_BASE_URL=http://core:8080

# 로그인
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션). 쉼표로 여러 개.
GOOGLE_OAUTH_CLIENT_IDS=
# access token(JWT) 서명 키, 32바이트 이상. 생성: openssl rand -base64 48 (로컬은 비워 둬도 개발용 키로 뜬다. 운영은 필수)
TRUPASS_JWT_SECRET=
# 운영(prod)에서 core를 부를 FE 주소, 쉼표로 여러 개. 로컬은 http://localhost:5173 이 기본으로 열려 있다.
# 같은 주소가 Google OAuth 클라이언트의 "승인된 JavaScript 원본"에도 있어야 FE의 구글 로그인 버튼이 뜬다.
# TRUPASS_CORS_ALLOWED_ORIGINS=https://trupass.online,https://www.trupass.online

# 운영(EC2, SPRING_PROFILES_ACTIVE=prod)에서만 필요. 로컬은 비워 둔다.
# Caddy가 이 도메인으로 TLS 인증서를 발급한다. 예: api.trupass.online
API_DOMAIN=
# 인증서 만료 알림을 받을 이메일
ACME_EMAIL=
# FE 주소, 쉼표로 여러 개, 끝 슬래시 없이. prod 프로필은 이 값이 없으면 뜨지 않는다. 예: https://www.trupass.online,https://trupass.online
TRUPASS_CORS_ALLOWED_ORIGINS=

# core → agent 내부 호출 키. core와 agent가 이 값을 같이 읽는다. 비어 있으면 agent가 503으로 거절한다.
# 생성: openssl rand -hex 32
INTERNAL_API_KEY=

# 외부 API (테스트 키)
TOSS_SECRET_KEY=
# Duffel 테스트 모드 토큰(duffel_test_로 시작). 항공 검색에 쓴다. live 토큰이면 core가 뜨지 않는다.
DUFFEL_ACCESS_TOKEN=
# LiteAPI 샌드박스 키(sand_로 시작). 숙소 검색에 쓴다. 운영 키면 core가 뜨지 않는다.
LITEAPI_SANDBOX_KEY=
TOURAPI_SERVICE_KEY=
# Gemini 키. agent는 GEMINI_API_KEY가 없으면 GOOGLE_API_KEY를 읽는다. 모델을 비우면 gemini-2.5-flash-lite.
GOOGLE_API_KEY=
GEMINI_MODEL=
# agent가 쓸 LLM 순서. 앞의 것이 실패하면 다음 키·모델로 넘어간다. 비우면 gemini 하나.
# 예: anthropic,gemini  (Claude 먼저, 안 되면 Gemini)
LLM_PROVIDERS=
# 키·모델은 쉼표로 여러 개. 같은 모델에 키를 차례로 붙이고, 그다음 모델로 넘어간다.
ANTHROPIC_API_KEYS=
# 비우면 claude-opus-5-5. 싸게 쓰려면 claude-haiku-5-5를 뒤에 붙인다.
ANTHROPIC_MODELS=
# Claude 생각 깊이(low/medium/high). 비우면 low.
ANTHROPIC_EFFORT=
# Gemini 키를 여러 개 쓸 때만. 비우면 GOOGLE_API_KEY 하나.
GEMINI_API_KEYS=
GEMINI_MODELS=
# 한 번 호출 제한 시간(초). core의 agent read-timeout(30초)보다 짧게 둔다.
LLM_TIMEOUT_SECONDS=
# 키·모델이 죽었을 때 다시 시도하기 전까지 쉬는 시간(초).
LLM_COOLDOWN_SECONDS=
