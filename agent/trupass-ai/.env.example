# Copy to .env. Never commit .env or paste real keys in chat.
GEMINI_API_KEY=replace-with-your-private-key
GEMINI_MODEL=gemini-3.5-flash-lite
INTERNAL_API_KEY=replace-with-a-random-long-private-token
PROMPT_TTL_SECONDS=600
PROMPT_MAX_ENTRIES=256
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256
# LLM order. If one fails, the next key/model is tried. Empty means gemini only.
# Example: LLM_PROVIDERS=anthropic,gemini
LLM_PROVIDERS=gemini
# Comma-separated. Keys are tried in order for each model, then the next model.
ANTHROPIC_API_KEYS=
ANTHROPIC_MODELS=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Only when using several Gemini keys/models. Empty falls back to GEMINI_API_KEY / GEMINI_MODEL.
GEMINI_API_KEYS=
GEMINI_MODELS=
LLM_TIMEOUT_SECONDS=25
LLM_COOLDOWN_SECONDS=60
